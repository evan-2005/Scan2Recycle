# Copy this file to .env.local and fill in your values. Never commit .env.local.
# Only PUBLIC values belong here: everything prefixed VITE_ is bundled into the app.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Hugging Face Space id: owner/space-name
VITE_HF_SPACE_ID=your-hf-username/scan2recycle-classifier
