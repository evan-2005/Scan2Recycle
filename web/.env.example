# Copy this file to .env.local and fill in your values. Never commit .env.local.
# Only PUBLIC values belong here: everything prefixed VITE_ is bundled into the app.

# Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" (or legacy "anon") key. NEVER put a secret / service_role key here.
VITE_SUPABASE_ANON_KEY=your-publishable-key
